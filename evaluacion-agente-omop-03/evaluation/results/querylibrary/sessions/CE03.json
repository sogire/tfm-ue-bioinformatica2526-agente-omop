            "functionCall": {
              "id": "adk-6d046992-dd72-40bd-a675-8f3d6cb363a3",
              "args": {
                "sql_query": "\nSELECT\n    CASE\n        WHEN (EXTRACT(YEAR FROM ce.condition_era_start_date) - p.year_of_birth) < 18 THEN '0-17'\n        WHEN (EXTRACT(YEAR FROM ce.condition_era_start_date) - p.year_of_birth) BETWEEN 18 AND 34 THEN '18-34'\n        WHEN (EXTRACT(YEAR FROM ce.condition_era_start_date) - p.year_of_birth) BETWEEN 35 AND 49 THEN '35-49'\n        WHEN (EXTRACT(YEAR FROM ce.condition_era_start_date) - p.year_of_birth) BETWEEN 50 AND 64 THEN '50-64'\n        ELSE '65+'\n    END AS age_group,\n    c_gender.concept_name AS gender,\n    MIN(DATE_DIFF(ce.condition_era_end_date, ce.condition_era_start_date, DAY) + 1) AS min_duration_days,\n    MAX(DATE_DIFF(ce.condition_era_end_date, ce.condition_era_start_date, DAY) + 1) AS max_duration_days,\n    AVG(CAST(DATE_DIFF(ce.condition_era_end_date, ce.condition_era_start_date, DAY) + 1 AS FLOAT64)) AS avg_duration_days\nFROM\n    `condition_era` AS ce\nJOIN\n    `person` AS p\nON\n    ce.person_id = p.person_id\nJOIN\n    `concept` AS c_gender\nON\n    p.gender_concept_id = c_gender.concept_id\nJOIN\n    `concept_ancestor` AS ca\nON\n    ce.condition_concept_id = ca.descendant_concept_id\nWHERE\n    ca.ancestor_concept_id = 359817006 -- Concept ID for 'Fracture of hip' or its broader equivalent\nGROUP BY\n    age_group,\n    gender\nORDER BY\n    age_group,\n    gender;\n"
              },
              "name": "validate_omop_sql"
            },
