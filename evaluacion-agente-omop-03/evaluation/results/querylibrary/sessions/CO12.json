          {
            "functionCall": {
              "id": "adk-68d25022-41bd-4db8-9a65-012a73339c75",
              "args": {
                "sql_query": "\nSELECT\n    AVG(UNIX_DATE(t.condition_end_date)) AS avg_condition_end_date_days_since_epoch,\n    STDDEV(UNIX_DATE(t.condition_end_date)) AS stddev_condition_end_date_days_since_epoch,\n    APPROX_QUANTILES(UNIX_DATE(t.condition_end_date), 100)[OFFSET(25)] AS percentile_25_condition_end_date_days_since_epoch,\n    APPROX_QUANTILES(UNIX_DATE(t.condition_end_date), 100)[OFFSET(50)] AS median_condition_end_date_days_since_epoch,\n    APPROX_QUANTILES(UNIX_DATE(t.condition_end_date), 100)[OFFSET(75)] AS percentile_75_condition_end_date_days_since_epoch\nFROM\n    `condition_occurrence` AS t\nWHERE\n    t.condition_end_date IS NOT NULL\n"
              },
              "name": "validate_omop_sql"
            },
