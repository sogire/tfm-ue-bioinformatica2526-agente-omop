    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "text": "```sql\nWITH ObservationPeriodMonths AS (\n    SELECT\n        op.person_id,\n        op.observation_period_start_date,\n        op.observation_period_end_date,\n        calendar_month_start_date\n    FROM\n        observation_period op,\n        UNNEST(GENERATE_DATE_ARRAY(\n            DATE_TRUNC(op.observation_period_start_date, MONTH),\n            DATE_TRUNC(op.observation_period_end_date, MONTH),\n            INTERVAL 1 MONTH\n        )) AS calendar_month_start_date\n),\nMonthlyOverlap AS (\n    SELECT\n        person_id,\n        calendar_month_start_date,\n        GREATEST(observation_period_start_date, calendar_month_start_date) AS overlap_start,\n        LEAST(observation_period_end_date, LAST_DAY(calendar_month_start_date)) AS overlap_end\n    FROM\n        ObservationPeriodMonths\n)\nSELECT\n    EXTRACT(MONTH FROM calendar_month_start_date) AS generic_month,\n    SUM(DATE_DIFF(overlap_end, overlap_start, DAY) + 1) AS total_person_days_active\nFROM\n    MonthlyOverlap\nGROUP BY\n    generic_month\nORDER BY\n    generic_month;\n```"
          }
        ],
        "role": "model"
      },
