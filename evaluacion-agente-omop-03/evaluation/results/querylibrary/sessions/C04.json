              "args": {
                "sql_query": "\nSELECT\n    c_meddra.concept_id AS meddra_concept_id,\n    c_meddra.concept_name AS meddra_concept_name,\n    cr.relationship_id,\n    r.relationship_name,\n    c_snomed.concept_id AS snomed_concept_id,\n    c_snomed.concept_name AS snomed_concept_name,\n    c_snomed.domain_id AS snomed_domain_id,\n    c_snomed.vocabulary_id AS snomed_vocabulary_id\nFROM\n    concept c_meddra\nJOIN\n    concept_relationship cr\n    ON c_meddra.concept_id = cr.concept_id_1\nJOIN\n    concept c_snomed\n    ON cr.concept_id_2 = c_snomed.concept_id\nJOIN\n    relationship r\n    ON cr.relationship_id = r.relationship_id\nWHERE\n    c_meddra.concept_id = 35205180\n    AND cr.relationship_id = 'MedDRA - SNOMED eq'\n    AND cr.invalid_reason IS NULL;\n"
