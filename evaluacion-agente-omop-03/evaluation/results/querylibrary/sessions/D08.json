              "args": {
                "sql_query": "\nSELECT\n    c.concept_id AS class_concept_id,\n    c.concept_name AS class_concept_name,\n    c.vocabulary_id AS class_vocabulary_id,\n    c.domain_id AS class_domain_id\nFROM\n    `concept_ancestor` ca\nJOIN\n    `concept` c ON ca.ancestor_concept_id = c.concept_id\nWHERE\n    ca.descendant_concept_id = 1545999\n    AND c.vocabulary_id IN ('ATC', 'EPC');\n"
