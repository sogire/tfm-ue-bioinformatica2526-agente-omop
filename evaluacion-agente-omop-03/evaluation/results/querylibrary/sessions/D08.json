      "content": {
        "parts": [
          {
            "text": "```sql\nSELECT\n    c.concept_id AS class_concept_id,\n    c.concept_name AS class_concept_name,\n    c.concept_code AS class_concept_code,\n    c.domain_id AS class_domain_id,\n    c.vocabulary_id AS class_vocabulary_id,\n    v.vocabulary_name AS class_vocabulary_name,\n    c.concept_class_id AS class_concept_class_id,\n    ca.min_levels_of_separation\nFROM\n    `concept_ancestor` ca\nJOIN\n    `concept` c\n    ON ca.ancestor_concept_id = c.concept_id\nJOIN\n    `vocabulary` v\n    ON c.vocabulary_id = v.vocabulary_id\nWHERE\n    ca.descendant_concept_id = 1545999\n    AND c.vocabulary_id IN ('ATC', 'EPC', 'NDFRT', 'ETC', 'VA Class')\n    AND c.concept_class_id IN ('ATC', 'VA Class', 'Mechanism of Action', 'Pharmacologic Class', 'Therapeutic Class', 'Ingredient', 'EPC', 'ETC')\n    AND CURRENT_DATE() BETWEEN c.valid_start_date AND c.valid_end_date;\n```"
          }
        ],
