              "args": {
                "sql_query": "\nSELECT\n    c.condition_concept_id,\n    cn.concept_name AS condition_name,\n    COUNT(c.condition_concept_id) AS prevalence_count\nFROM\n    person p\nJOIN\n    death d ON p.person_id = d.person_id\nJOIN\n    condition_occurrence c ON p.person_id = c.person_id\nJOIN\n    concept cn ON c.condition_concept_id = cn.concept_id\nWHERE\n    c.condition_start_date BETWEEN DATE_SUB(d.death_date, INTERVAL 30 DAY) AND d.death_date\nGROUP BY\n    c.condition_concept_id,\n    cn.concept_name\nORDER BY\n    prevalence_count DESC\nLIMIT 100\n"
              },
              "name": "validate_omop_sql"
