                "sql_query": "\nSELECT\n  c1.concept_id AS medication_concept_id,\n  c1.concept_name AS medication_name,\n  c2.concept_id AS brand_concept_id,\n  c2.concept_name AS brand_name,\n  c2.vocabulary_id AS brand_vocabulary,\n  c2.domain_id AS brand_domain\nFROM\n  `concept` AS c1\nJOIN\n  `concept_relationship` AS cr\nON\n  c1.concept_id = cr.concept_id_1\nJOIN\n  `concept` AS c2\nON\n  cr.concept_id_2 = c2.concept_id\nWHERE\n  c1.concept_id IN (1516830, 19046168)\n  AND cr.relationship_id = '44818789' -- 'RxNorm has brand name'\n  AND c2.standard_concept = 'S'\n  AND c2.invalid_reason IS NULL\n"
