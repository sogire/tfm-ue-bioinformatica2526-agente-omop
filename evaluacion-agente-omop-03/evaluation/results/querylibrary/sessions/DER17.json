                "sql_query": "\nSELECT\n    EXTRACT(MONTH FROM drug_era_start_date) AS observation_month,\n    COUNT(1) AS active_drug_era_episodes\nFROM\n    drug_era\nWHERE\n    EXTRACT(MONTH FROM drug_era_start_date) IN (3, 5)\nGROUP BY\n    EXTRACT(MONTH FROM drug_era_start_date)\nORDER BY\n    observation_month\n"
