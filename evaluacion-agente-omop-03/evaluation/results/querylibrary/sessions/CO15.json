      "content": {
        "parts": [
          {
            "text": "Calcular la distribución estadística (media, desviación típica, cuartiles y valores extremos) del número de diagnósticos clínicos distintos que presenta cada paciente. Genera directamente la consulta SQL para BigQuery."
          }
        ],
        "role": "user"
      },
      "invocationId": "e-15538b44-ec1f-446c-9317-24dc2150018f",
      "author": "user",
      "actions": {
