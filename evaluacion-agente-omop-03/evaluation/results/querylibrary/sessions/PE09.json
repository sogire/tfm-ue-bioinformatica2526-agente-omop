                "sql_query": "\nSELECT\n  c.concept_name AS gender,\n  p.year_of_birth,\n  COUNT(DISTINCT p.person_id) AS patient_count\nFROM\n  `person` AS p\nJOIN\n  `concept` AS c\nON\n  p.gender_concept_id = c.concept_id\nGROUP BY\n  c.concept_name,\n  p.year_of_birth\nORDER BY\n  p.year_of_birth, c.concept_name;\n"
