                "sql_query": "\nSELECT\n  ce.condition_concept_id,\n  MIN(ce.condition_era_end_date) AS min_end_date,\n  MAX(ce.condition_era_end_date) AS max_end_date,\n  DATE(DATE_ADD('1970-01-01', INTERVAL CAST(AVG(CAST(UNIX_DATE(ce.condition_era_end_date) AS BIGNUMERIC)) AS INT64) DAY)) AS mean_end_date,\n  STDDEV(CAST(UNIX_DATE(ce.condition_era_end_date) AS BIGNUMERIC)) AS stddev_end_date_days,\n  DATE(DATE_ADD('1970-01-01', INTERVAL CAST(APPROX_QUANTILES(UNIX_DATE(ce.condition_era_end_date), 4)[OFFSET(1)] AS INT64) DAY)) AS p25_end_date,\n  DATE(DATE_ADD('1970-01-01', INTERVAL CAST(APPROX_QUANTILES(UNIX_DATE(ce.condition_era_end_date), 4)[OFFSET(2)] AS INT64) DAY)) AS median_end_date,\n  DATE(DATE_ADD('1970-01-01', INTERVAL CAST(APPROX_QUANTILES(UNIX_DATE(ce.condition_era_end_date), 4)[OFFSET(3)] AS INT64) DAY)) AS p75_end_date\nFROM\n  `condition_era` AS ce\nWHERE\n  ce.condition_concept_id IN (256723, 372906, 435371, 440377, 441202)\nGROUP BY\n  ce.condition_concept_id\n"
