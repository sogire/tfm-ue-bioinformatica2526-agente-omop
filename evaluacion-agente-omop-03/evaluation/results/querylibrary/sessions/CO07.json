                "sql_query": "\nWITH NauseaPatients AS (\n    SELECT DISTINCT\n        co.person_id\n    FROM\n        `condition_occurrence` AS co\n    WHERE\n        co.condition_concept_id = 31967\n),\nHospitalizedNauseaPatients AS (\n    SELECT DISTINCT\n        co.person_id\n    FROM\n        `condition_occurrence` AS co\n    JOIN\n        `visit_occurrence` AS vo\n        ON co.person_id = vo.person_id\n        AND co.visit_occurrence_id = vo.visit_occurrence_id\n    WHERE\n        co.condition_concept_id = 31967\n        AND vo.visit_concept_id IN (9201, 9203) -- 9201: Inpatient Visit, 9203: Emergency Room and Inpatient Visit\n)\nSELECT\n    COUNT(DISTINCT np.person_id) AS TotalNauseaPatients,\n    COUNT(DISTINCT hnp.person_id) AS NauseaPatientsWithHospitalization,\n    CAST(COUNT(DISTINCT hnp.person_id) AS BIGNUMERIC) * 100 / NULLIF(CAST(COUNT(DISTINCT np.person_id) AS BIGNUMERIC), 0) AS PercentageWithHospitalization\nFROM\n    NauseaPatients AS np\nLEFT JOIN\n    HospitalizedNauseaPatients AS hnp\n    ON np.person_id = hnp.person_id;\n"
