      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-8b8a04d1-c8da-419b-94d7-b60e6fdab0cd",
              "args": {
                "sql_query": "\nSELECT\n    c.concept_id,\n    c.concept_name,\n    c.domain_id,\n    c.vocabulary_id\nFROM\n    `concept` AS c\nJOIN\n    `concept_ancestor` AS ca\nON\n    c.concept_id = ca.descendant_concept_id\nWHERE\n    ca.ancestor_concept_id = 192671\n    AND c.standard_concept = 'S'\n    AND c.invalid_reason IS NULL;\n"
              },
              "name": "validate_omop_sql"
