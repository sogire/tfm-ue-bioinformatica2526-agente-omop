      "errorMessage": "Malformed function call: sql_query = \"\"\"\nSELECT DISTINCT\n    CASE\n        WHEN c1.concept_name < c2.concept_name THEN c1.concept_name\n        ELSE c2.concept_name\n    END AS condition_a,\n    CASE\n        WHEN c1.concept_name < c2.concept_name THEN c2.concept_name\n        ELSE c1.concept_name\n    END AS condition_b\nFROM\n    condition_era AS t1\nJOIN\n    condition_era AS t2\nON\n    t1.person_id = t2.person_id\n    AND t2.condition_era_start_date <= t1.condition_era_end_date\n    AND (t2.condition_era_end_date IS NULL OR t2.condition_era_end_date >= t1.condition_era_start_date)\nJOIN\n    concept AS c1\nON\n    t1.condition_concept_id = c1.concept_id\nJOIN\n    concept AS c2\nON\n    t2.condition_concept_id = c2.concept_id\nWHERE\n    t1.person_id = [YOUR_PERSON_ID] -- Reemplaza con el ID del paciente deseado\n    AND t1.condition_concept_id <> t2.condition_concept_id\nORDER BY\n    condition_a, condition_b;\n\"\"\"\nprint(default_api.validate_omop_sql(sql_query=sql_query))",
