          {
            "functionCall": {
              "id": "adk-e9d8c50d-d6d8-46d2-92f4-4fbfef7e1ae7",
              "args": {
                "sql_query": "\nSELECT DISTINCT\n    CASE\n        WHEN c1.concept_name < c2.concept_name THEN c1.concept_name\n        ELSE c2.concept_name\n    END AS condition_1_name,\n    CASE\n        WHEN c1.concept_name < c2.concept_name THEN c2.concept_name\n        ELSE c1.concept_name\n    END AS condition_2_name,\n    t1.condition_era_start_date AS condition_1_start_date,\n    t1.condition_era_end_date AS condition_1_end_date,\n    t2.condition_era_start_date AS condition_2_start_date,\n    t2.condition_era_end_date AS condition_2_end_date\nFROM\n    condition_era AS t1\nJOIN\n    condition_era AS t2\n    ON t1.person_id = t2.person_id\n    AND t2.condition_era_start_date <= t1.condition_era_end_date\n    AND (t2.condition_era_end_date IS NULL OR t2.condition_era_end_date >= t1.condition_era_start_date)\nJOIN\n    concept AS c1\n    ON t1.condition_concept_id = c1.concept_id\nJOIN\n    concept AS c2\n    ON t2.condition_concept_id = c2.concept_id\nWHERE\n    t1.person_id = [YOUR_PERSON_ID_HERE] -- Reemplaza con el ID del paciente\n    AND t1.condition_concept_id <> t2.condition_concept_id\nORDER BY\n    condition_1_name, condition_2_name;\n"
              },
              "name": "validate_omop_sql"
            },
