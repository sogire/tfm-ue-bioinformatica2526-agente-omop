      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-f53ef801-78bd-48b3-b0d4-fb5c355fe883",
              "args": {
                "sql_query": "\nWITH PatientConditionCounts AS (\n    SELECT\n        person_id,\n        COUNT(condition_occurrence_id) AS condition_count\n    FROM\n        `condition_occurrence`\n    GROUP BY\n        person_id\n)\nSELECT\n    CAST(AVG(condition_count) AS FLOAT64) AS mean_condition_records,\n    MIN(condition_count) AS min_condition_records,\n    MAX(condition_count) AS max_condition_records,\n    CAST(PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY condition_count) AS FLOAT64) AS percentile_25_condition_records,\n    CAST(PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY condition_count) AS FLOAT64) AS percentile_50_condition_records,\n    CAST(PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY condition_count) AS FLOAT64) AS percentile_75_condition_records\nFROM\n    PatientConditionCounts;\n"
              },
              "name": "validate_omop_sql"
            },
