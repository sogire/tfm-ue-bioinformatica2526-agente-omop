                "sql_query": "\nSELECT\n    drug.concept_id AS drug_concept_id,\n    drug.concept_name AS drug_name,\n    drug.concept_code AS drug_concept_code\nFROM\n    concept_relationship AS r\nJOIN\n    concept_ancestor AS snomed ON r.concept_id_1 = snomed.descendant_concept_id\nJOIN\n    concept_ancestor AS ind ON r.concept_id_2 = ind.ancestor_concept_id\nJOIN\n    concept AS drug ON ind.descendant_concept_id = drug.concept_id\nWHERE\n    snomed.ancestor_concept_id IN (253954, 4310580)\n    AND r.relationship_id IN ('247', '248')\n    AND CURRENT_DATE() BETWEEN drug.valid_start_date AND drug.valid_end_date;\n"
