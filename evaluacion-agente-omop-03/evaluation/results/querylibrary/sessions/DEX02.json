      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "text": "```sql\nSELECT\n    dc.concept_name AS drug_concept_name,\n    gc.concept_name AS gender_concept_name,\n    EXTRACT(YEAR FROM de.drug_exposure_start_date) AS year_of_dispensation,\n    CASE\n        WHEN (EXTRACT(YEAR FROM de.drug_exposure_start_date) - p.year_of_birth) BETWEEN 0 AND 19 THEN '0-19'\n        WHEN (EXTRACT(YEAR FROM de.drug_exposure_start_date) - p.year_of_birth) BETWEEN 20 AND 39 THEN '20-39'\n        WHEN (EXTRACT(YEAR FROM de.drug_exposure_start_date) - p.year_of_birth) BETWEEN 40 AND 59 THEN '40-59'\n        WHEN (EXTRACT(YEAR FROM de.drug_exposure_start_date) - p.year_of_birth) BETWEEN 60 AND 79 THEN '60-79'\n        WHEN (EXTRACT(YEAR FROM de.drug_exposure_start_date) - p.year_of_birth) >= 80 THEN '80+'\n        ELSE 'Unknown'\n    END AS age_group,\n    COUNT(DISTINCT de.person_id) AS count_of_patients\nFROM\n    `drug_exposure` AS de\nJOIN\n    `person` AS p\nON\n    de.person_id = p.person_id\nJOIN\n    `concept` AS dc\nON\n    de.drug_concept_id = dc.concept_id\nJOIN\n    `concept` AS gc\nON\n    p.gender_concept_id = gc.concept_id\nWHERE\n    de.drug_concept_id IN (40165254, 40165258)\nGROUP BY\n    drug_concept_name,\n    gender_concept_name,\n    year_of_dispensation,\n    age_group\nORDER BY\n    drug_concept_name,\n    gender_concept_name,\n    year_of_dispensation,\n    age_group\n```\n"
          }
        ],
