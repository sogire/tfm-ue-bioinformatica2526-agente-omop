    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-9a343ad6-cb60-444c-bc96-50806ff12536",
              "args": {
                "sql_query": "\nSELECT\n    AVG(DATE_DIFF(de.drug_exposure_start_date, de.previous_exposure_date, DAY)) AS average_days_between_treatments\nFROM (\n    SELECT\n        drug_exposure_start_date,\n        person_id,\n        LAG(drug_exposure_start_date, 1) OVER (PARTITION BY person_id ORDER BY drug_exposure_start_date) AS previous_exposure_date\n    FROM\n        `drug_exposure`\n    WHERE\n        drug_concept_id = 1304643\n) AS de\nWHERE\n    de.previous_exposure_date IS NOT NULL\n"
              },
