            "functionCall": {
              "id": "adk-05aaf0c2-3b2a-40da-8b6a-fab470136b2f",
              "args": {
                "sql_query": "\nWITH FirstObservationPeriod AS (\n    SELECT\n        op.person_id,\n        op.observation_period_start_date,\n        op.observation_period_end_date,\n        ROW_NUMBER() OVER (PARTITION BY op.person_id ORDER BY op.observation_period_start_date) AS rn\n    FROM\n        `observation_period` AS op\n),\nObservationDuration AS (\n    SELECT\n        person_id,\n        DATE_DIFF(observation_period_end_date, observation_period_start_date, MONTH) AS duration_months\n    FROM\n        FirstObservationPeriod\n    WHERE\n        rn = 1\n)\nSELECT\n    duration_months,\n    COUNT(person_id) AS patient_count\nFROM\n    ObservationDuration\nGROUP BY\n    duration_months\nORDER BY\n    duration_months;\n"
              },
              "name": "validate_omop_sql"
            },
