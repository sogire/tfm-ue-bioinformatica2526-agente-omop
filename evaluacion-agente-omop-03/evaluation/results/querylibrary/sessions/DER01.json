          {
            "text": "SELECT\n    de.person_id,\n    de.drug_exposure_id,\n    de.drug_concept_id,\n    de.drug_exposure_start_date,\n    de.drug_exposure_end_date,\n    de.drug_type_concept_id,\n    de.quantity,\n    de.days_supply,\n    de.sig,\n    de.route_concept_id,\n    de.refills,\n    de.drug_source_value,\n    de.drug_source_concept_id,\n    de.route_source_value,\n    de.dose_unit_source_value\nFROM\n    `drug_exposure` AS de\nJOIN\n    `concept_ancestor` AS ca\n    ON de.drug_concept_id = ca.descendant_concept_id\nJOIN\n    `drug_era` AS der\n    ON de.person_id = der.person_id\n    AND ca.ancestor_concept_id = der.drug_concept_id\nWHERE\n    de.drug_exposure_start_date >= der.drug_era_start_date\n    AND de.drug_exposure_start_date <= der.drug_era_end_date\n    AND der.drug_era_id = 20\nORDER BY\n    de.person_id, de.drug_exposure_start_date;"
          }
