            "functionCall": {
              "id": "adk-5f6c3cfb-6283-411c-8034-0d83170105a8",
              "args": {
                "sql_query": "\nSELECT\n    c.concept_id,\n    c.concept_name,\n    c.domain_id,\n    c.vocabulary_id,\n    c.standard_concept,\n    c.concept_code,\n    c.valid_start_date,\n    c.valid_end_date,\n    cr.relationship_id,\n    c2.concept_name AS related_concept_name,\n    c2.concept_id AS related_concept_id,\n    cs.concept_synonym_name\nFROM\n    `concept` AS c\nLEFT JOIN\n    `concept_synonym` AS cs\n    ON c.concept_id = cs.concept_id\nLEFT JOIN\n    `concept_relationship` AS cr\n    ON c.concept_id = cr.concept_id_1\nLEFT JOIN\n    `concept` AS c2\n    ON cr.concept_id_2 = c2.concept_id\nWHERE\n    c.domain_id = 'Drug'\n    AND c.vocabulary_id = 'RxNorm'\n    AND c.standard_concept = 'S'\n    AND CURRENT_DATE() BETWEEN c.valid_start_date AND c.valid_end_date\n    AND (LOWER(c.concept_name) LIKE '%lipitor%' OR LOWER(cs.concept_synonym_name) LIKE '%lipitor%')\nORDER BY\n    c.concept_id, cr.relationship_id, cs.concept_synonym_name\n"
              },
