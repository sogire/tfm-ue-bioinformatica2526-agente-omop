            "functionCall": {
              "id": "adk-369d71fa-eb66-4ffd-9634-47d3a4e43d2e",
              "args": {
                "sql_query": "\nSELECT\n    c.concept_id,\n    c.concept_name,\n    c.domain_id,\n    c.vocabulary_id,\n    c.standard_concept,\n    c.concept_code,\n    c.valid_start_date,\n    c.valid_end_date,\n    cr.relationship_id,\n    c2.concept_name AS related_concept_name,\n    c2.concept_id AS related_concept_id,\n    cs.concept_synonym_name\nFROM\n    `concept` AS c\nLEFT JOIN\n    `concept_relationship` AS cr\n    ON c.concept_id = cr.concept_id_1\nLEFT JOIN\n    `concept` AS c2\n    ON cr.concept_id_2 = c2.concept_id\nLEFT JOIN\n    `concept_synonym` AS cs\n    ON c.concept_id = cs.concept_id\nWHERE\n    c.concept_id IN (1545998, 1545999, 19023382, 19023383)\nORDER BY\n    c.concept_id, cr.relationship_id, cs.concept_synonym_name\n"
              },
              "name": "validate_omop_sql"
