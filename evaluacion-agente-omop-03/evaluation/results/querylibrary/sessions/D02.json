    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "text": "```sql\nSELECT\n    c.concept_id,\n    c.concept_name,\n    c.domain_id,\n    c.vocabulary_id,\n    c.standard_concept,\n    c.concept_class_id,\n    c.concept_code,\n    c.valid_start_date,\n    c.valid_end_date,\n    cr.relationship_id,\n    c2.concept_name AS related_concept_name,\n    c2.concept_id AS related_concept_id,\n    cs.concept_synonym_name\nFROM\n    `concept` AS c\nLEFT JOIN\n    `concept_synonym` AS cs\n    ON c.concept_id = cs.concept_id\nLEFT JOIN\n    `concept_relationship` AS cr\n    ON c.concept_id = cr.concept_id_1\nLEFT JOIN\n    `concept` AS c2\n    ON cr.concept_id_2 = c2.concept_id\nWHERE\n    c.standard_concept = 'S'\n    AND c.concept_class_id IS NOT NULL\n    AND CURRENT_DATE() BETWEEN c.valid_start_date AND c.valid_end_date\n    AND c.vocabulary_id IN ('RxNorm', 'ATC', 'NDFRT', 'VA Class')\n    AND c.domain_id IN ('Drug', 'Drug Clinical Dose Group', 'Drug Ingredient', 'Drug Product', 'VA Class', 'ATC', 'NDFRT')\n    AND (LOWER(c.concept_name) LIKE '%lipitor%' OR LOWER(cs.concept_synonym_name) LIKE '%lipitor%')\nORDER BY\n    c.concept_id, cr.relationship_id, cs.concept_synonym_name\n```",
