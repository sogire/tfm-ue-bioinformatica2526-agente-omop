        "parts": [
          {
            "text": "```sql\nSELECT DISTINCT\n    c.concept_id,\n    c.concept_name,\n    c.domain_id,\n    c.vocabulary_id\nFROM\n    `concept` AS c\nLEFT JOIN\n    `concept_synonym` AS cs\nON\n    c.concept_id = cs.concept_id\nWHERE\n    c.domain_id = 'Procedure'\n    AND c.standard_concept = 'S'\n    AND (LOWER(c.concept_name) LIKE '%artery bypass%' OR LOWER(cs.concept_synonym_name) LIKE '%artery bypass%')\n    AND CURRENT_DATE() BETWEEN c.valid_start_date AND c.valid_end_date\n    AND c.vocabulary_id IN ('SNOMED', 'CPT4', 'HCPCS')\nORDER BY\n    c.concept_name\n```"
          }
