    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-eb382611-ffa0-45f7-8abe-af90c4faaaa3",
              "args": {
                "sql_query": "SELECT\n    c.concept_id AS child_concept_id,\n    c.concept_name AS child_concept_name,\n    c.domain_id,\n    c.vocabulary_id\nFROM\n    `concept` c\nJOIN\n    `concept_relationship` cr ON c.concept_id = cr.concept_id_2\nWHERE\n    cr.concept_id_1 = 192671\n    AND cr.relationship_id = 'Has a direct child'\n    AND c.standard_concept = 'S'\n    AND c.invalid_reason IS NULL;"
              },
