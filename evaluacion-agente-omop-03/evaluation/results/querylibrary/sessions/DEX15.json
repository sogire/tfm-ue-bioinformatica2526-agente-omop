            "functionCall": {
              "id": "adk-548c5bef-a84a-4f6d-a78f-737f4924442d",
              "args": {
                "sql_query": "SELECT\n    COUNT(DISTINCT de_first.person_id)\nFROM\n    (\n        SELECT\n            de.person_id,\n            MIN(de.drug_exposure_start_date) AS index_date\n        FROM\n            `drug_exposure` AS de\n        JOIN\n            `concept_ancestor` AS ca\n            ON de.drug_concept_id = ca.descendant_concept_id\n        WHERE\n            ca.ancestor_concept_id = 1539403 -- Statin (Simvastatin) and its descendants\n        GROUP BY\n            de.person_id\n    ) AS de_first\nJOIN\n    `observation_period` AS op\n    ON de_first.person_id = op.person_id\nWHERE\n    de_first.index_date >= op.observation_period_start_date\n    AND de_first.index_date <= op.observation_period_end_date\n    AND op.observation_period_start_date <= DATE_SUB(de_first.index_date, INTERVAL 180 DAY)\n    AND op.observation_period_end_date >= DATE_ADD(de_first.index_date, INTERVAL 365 DAY)"
              },
              "name": "validate_omop_sql"
