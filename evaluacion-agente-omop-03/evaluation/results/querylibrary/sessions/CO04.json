            "functionCall": {
              "id": "adk-03512f2e-d639-4e9e-9c83-d51c80f0d7d1",
              "args": {
                "sql_query": "\nSELECT\n    c.concept_name AS place_of_service_type,\n    COUNT(co.condition_occurrence_id) AS nausea_diagnosis_count\nFROM\n    `condition_occurrence` AS co\nJOIN\n    `visit_occurrence` AS vo\nON\n    co.visit_occurrence_id = vo.visit_occurrence_id\nJOIN\n    `concept` AS c\nON\n    vo.visit_concept_id = c.concept_id\nWHERE\n    co.condition_concept_id = 31967\nGROUP BY\n    c.concept_name\nORDER BY\n    nausea_diagnosis_count DESC;\n"
              },
              "name": "validate_omop_sql"
            },
