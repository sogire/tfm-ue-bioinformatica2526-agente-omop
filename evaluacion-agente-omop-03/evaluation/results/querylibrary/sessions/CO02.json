      "content": {
        "parts": [
          {
            "text": "```sql\nSELECT\n    MIN(co.condition_start_date) AS earliest_global_diagnosis_date\nFROM\n    condition_occurrence AS co\nWHERE\n    co.condition_concept_id = 23988\n    AND EXISTS (\n        SELECT 1\n        FROM\n            observation_period AS op\n        WHERE\n            op.person_id = co.person_id\n            AND op.observation_period_start_date <= DATE_SUB(co.condition_start_date, INTERVAL 6 MONTH)\n            AND op.observation_period_end_date >= co.condition_start_date\n    );\n```",
