                "sql_query": "\nWITH\n  DrugExposureCounts AS (\n    SELECT\n      de.person_id,\n      COUNT(de.drug_exposure_id) AS drug_exposure_count\n    FROM\n      `drug_exposure` AS de\n    GROUP BY\n      de.person_id\n  )\nSELECT\n  AVG(drug_exposure_count) AS mean_drug_exposures,\n  STDDEV(drug_exposure_count) AS stddev_drug_exposures,\n  APPROX_QUANTILES(drug_exposure_count, 100)[OFFSET(25)] AS percentile_25_drug_exposures,\n  APPROX_QUANTILES(drug_exposure_count, 100)[OFFSET(50)] AS percentile_50_drug_exposures,\n  APPROX_QUANTILES(drug_exposure_count, 100)[OFFSET(75)] AS percentile_75_drug_exposures\nFROM\n  DrugExposureCounts\n"
