                "sql_query": "SELECT\n    co.person_id,\n    co.condition_occurrence_id,\n    c.concept_name AS condition_name,\n    co.condition_start_date,\n    co.condition_end_date,\n    DATE_DIFF(COALESCE(co.condition_end_date, co.condition_start_date), co.condition_start_date, DAY) AS duration_days\nFROM\n    `condition_occurrence` AS co\nJOIN\n    `concept` AS c\n    ON co.condition_concept_id = c.concept_id\nWHERE\n    co.condition_concept_id = 200219"
