    },
    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-a9945c0d-0fc1-4637-8f18-b2bcba962a66",
              "args": {
                "sql_query": "SELECT\n  c.concept_id,\n  c.concept_name,\n  c.domain_id,\n  c.vocabulary_id,\n  c.concept_class_id\nFROM\n  `concept` AS c\nWHERE\n  LOWER(c.concept_name) LIKE LOWER('%Streptococcus pneumoniae%')\n  AND c.concept_class_id = 'Organism'\n  AND c.standard_concept = 'S'\n  AND c.invalid_reason IS NULL"
              },
