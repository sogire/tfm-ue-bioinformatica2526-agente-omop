                "sql_query": "\nWITH\n  DrugExposureCounts AS (\n    SELECT\n      person_id,\n      COUNT(drug_exposure_id) AS drug_exposure_count\n    FROM\n      `drug_exposure`\n    GROUP BY\n      person_id\n  )\nSELECT\n  drug_exposure_count,\n  COUNT(DISTINCT person_id) AS number_of_people,\n  NTILE(100) OVER (\n    ORDER BY\n      drug_exposure_count\n  ) AS percentile_rank\nFROM\n  DrugExposureCounts\nGROUP BY\n  drug_exposure_count\nORDER BY\n  drug_exposure_count;\n"
