    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-a1afb852-72f3-40f1-b29a-3aacf66861c9",
              "args": {
                "sql_query": "WITH\n  DrugExposureCounts AS (\n    SELECT\n      person_id,\n      COUNT(drug_exposure_id) AS drug_exposure_count\n    FROM\n      `drug_exposure`\n    GROUP BY\n      person_id\n  )\nSELECT\n  MIN(DEC.drug_exposure_count) AS min_drug_exposures_per_person,\n  MAX(DEC.drug_exposure_count) AS max_drug_exposures_per_person,\n  CAST(AVG(DEC.drug_exposure_count) AS FLOAT64) AS avg_drug_exposures_per_person,\n  CAST(STDDEV(DEC.drug_exposure_count) AS FLOAT64) AS stddev_drug_exposures_per_person,\n  PERCENTILE_DISC(0.25) WITHIN GROUP (ORDER BY DEC.drug_exposure_count) AS p25_drug_exposures_per_person,\n  PERCENTILE_DISC(0.50) WITHIN GROUP (ORDER BY DEC.drug_exposure_count) AS p50_drug_exposures_per_person,\n  PERCENTILE_DISC(0.75) WITHIN GROUP (ORDER BY DEC.drug_exposure_count) AS p75_drug_exposures_per_person\nFROM\n  DrugExposureCounts AS DEC;"
              },
              "name": "validate_omop_sql"
            },
