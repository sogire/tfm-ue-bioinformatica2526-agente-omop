    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-b8a5ea96-2075-43ea-a46e-1cc4cf8448fb",
              "args": {
                "sql_query": "SELECT\n  c.concept_id AS codigo_fuente,\n  c.concept_name AS nombre,\n  c.concept_class_id AS clase_de_concepto,\n  c.vocabulary_id AS vocabulario,\n  CASE WHEN c.standard_concept = 'S' AND c.invalid_reason IS NULL THEN 'True' ELSE 'False' END AS es_concepto_valido\nFROM\n  `concept` AS c\nWHERE\n  c.concept_id = 192671\n  AND c.standard_concept = 'S'\n  AND c.invalid_reason IS NULL;"
              },
