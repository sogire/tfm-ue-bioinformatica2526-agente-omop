    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "text": "```sql\nWITH PersonAge AS (\n    SELECT\n        p.person_id,\n        p.gender_concept_id,\n        CAST(EXTRACT(YEAR FROM first_op.first_obs_start) - p.year_of_birth AS FLOAT64) AS age_at_first_observation_start\n    FROM\n        person AS p\n    JOIN\n        (SELECT\n            person_id,\n            MIN(observation_period_start_date) AS first_obs_start\n        FROM\n            observation_period\n        GROUP BY\n            person_id\n        ) AS first_op\n        ON p.person_id = first_op.person_id\n)\nSELECT\n    gc.concept_name AS gender,\n    MIN(pa.age_at_first_observation_start) AS min_age_at_first_observation,\n    MAX(pa.age_at_first_observation_start) AS max_age_at_first_observation,\n    AVG(pa.age_at_first_observation_start) AS avg_age_at_first_observation,\n    STDDEV(pa.age_at_first_observation_start) AS stddev_age_at_first_observation,\n    APPROX_QUANTILES(pa.age_at_first_observation_start, 100)[OFFSET(25)] AS percentile_25,\n    APPROX_QUANTILES(pa.age_at_first_observation_start, 100)[OFFSET(50)] AS median_age,\n    APPROX_QUANTILES(pa.age_at_first_observation_start, 100)[OFFSET(75)] AS percentile_75,\n    COUNT(pa.person_id) AS total_patients\nFROM\n    PersonAge AS pa\nJOIN\n    concept AS gc\n    ON pa.gender_concept_id = gc.concept_id\nGROUP BY\n    gc.concept_name\nORDER BY\n    gc.concept_name;\n```"
          }
        ],
