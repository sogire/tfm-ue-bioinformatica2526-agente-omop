            "functionCall": {
              "id": "adk-b2209ec8-a615-418f-a53d-64e7f6bf4d3e",
              "args": {
                "sql_query": "\nSELECT\n    c.concept_name AS gender,\n    EXTRACT(YEAR FROM op.observation_period_start_date) - p.year_of_birth AS age_at_observation_start,\n    COUNT(DISTINCT p.person_id) AS number_of_patients\nFROM\n    person AS p\nJOIN\n    observation_period AS op\n    ON p.person_id = op.person_id\nJOIN\n    concept AS c\n    ON p.gender_concept_id = c.concept_id\nGROUP BY\n    c.concept_name,\n    age_at_observation_start\nORDER BY\n    c.concept_name,\n    age_at_observation_start;\n"
              },
              "name": "validate_omop_sql"
