              "args": {
                "sql_query": "\nSELECT\n    CAST(AVG(p.year_of_birth) AS FLOAT64) AS mean_year_of_birth,\n    CAST(STDDEV(p.year_of_birth) AS FLOAT64) AS stddev_year_of_birth,\n    MIN(p.year_of_birth) AS min_year_of_birth,\n    APPROX_QUANTILES(p.year_of_birth, 100)[OFFSET(25)] AS percentile_25_year_of_birth,\n    APPROX_QUANTILES(p.year_of_birth, 100)[OFFSET(50)] AS median_year_of_birth,\n    APPROX_QUANTILES(p.year_of_birth, 100)[OFFSET(75)] AS percentile_75_year_of_birth,\n    MAX(p.year_of_birth) AS max_year_of_birth\nFROM\n    `person` AS p\nWHERE\n    p.year_of_birth IS NOT NULL\n"
