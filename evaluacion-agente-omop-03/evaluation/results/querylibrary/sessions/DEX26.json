              "args": {
                "sql_query": "\nSELECT\n  AVG(CAST(UNIX_DATE(drug_exposure_end_date) AS FLOAT64)) AS mean_exposure_end_date_days,\n  STDDEV(CAST(UNIX_DATE(drug_exposure_end_date) AS FLOAT64)) AS stddev_exposure_end_date_days,\n  MIN(drug_exposure_end_date) AS min_exposure_end_date,\n  MAX(drug_exposure_end_date) AS max_exposure_end_date,\n  CAST(APPROX_QUANTILES(UNIX_DATE(drug_exposure_end_date), 100)[OFFSET(25)] AS BIGNUMERIC) AS p25_exposure_end_date_days,\n  CAST(APPROX_QUANTILES(UNIX_DATE(drug_exposure_end_date), 100)[OFFSET(50)] AS BIGNUMERIC) AS p50_exposure_end_date_days,\n  CAST(APPROX_QUANTILES(UNIX_DATE(drug_exposure_end_date), 100)[OFFSET(75)] AS BIGNUMERIC) AS p75_exposure_end_date_days\nFROM\n  `drug_exposure`\n"
