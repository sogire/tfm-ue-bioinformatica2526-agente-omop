                "sql_query": "\nSELECT\n    a.concept_id AS condition_concept_id,\n    a.concept_name AS condition_name,\n    a.domain_id AS condition_domain,\n    d.concept_id AS causative_agent_concept_id,\n    d.concept_name AS causative_agent_name,\n    d.domain_id AS causative_agent_domain\nFROM\n    `concept_relationship` cr\nJOIN\n    `concept` a ON cr.concept_id_1 = a.concept_id\nJOIN\n    `concept` d ON cr.concept_id_2 = d.concept_id\nWHERE\n    cr.relationship_id = 'Has causative agent'\n    AND d.concept_id = 4248851;\n"
