        "parts": [
          {
            "functionCall": {
              "id": "adk-1620d80f-7efc-4a8f-b091-319ccae60c80",
              "args": {
                "sql_query": "\nSELECT\n    dt_concept.concept_name AS drug_exposure_type,\n    COUNT(DISTINCT de.drug_exposure_id) AS exposure_count\nFROM\n    `drug_exposure` AS de\nJOIN\n    `concept` AS dt_concept\n    ON de.drug_type_concept_id = dt_concept.concept_id\nJOIN\n    `condition_occurrence` AS co\n    ON de.person_id = co.person_id\nWHERE\n    co.condition_concept_id IN (253954, 37116831, 40490351, 40490814)\nGROUP BY\n    dt_concept.concept_name\nORDER BY\n    exposure_count DESC;\n"
              },
              "name": "validate_omop_sql"
            },
