    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-68e2d6d3-6fdc-4af3-9c54-3e83e334c33f",
              "args": {
                "sql_query": "\nSELECT\n    distinct_condition_count,\n    COUNT(person_id) AS number_of_patients\nFROM (\n    SELECT\n        t1.person_id,\n        COUNT(DISTINCT t1.condition_concept_id) AS distinct_condition_count\n    FROM\n        `condition_occurrence` AS t1\n    WHERE\n        t1.person_id IN (\n            SELECT\n                person_id\n            FROM\n                `condition_occurrence`\n            WHERE\n                condition_concept_id = 201820 -- Diabetes Mellitus\n        )\n    GROUP BY\n        t1.person_id\n) AS patient_condition_counts\nGROUP BY\n    distinct_condition_count\nORDER BY\n    distinct_condition_count;\n"
              },
              "name": "validate_omop_sql"
            },
