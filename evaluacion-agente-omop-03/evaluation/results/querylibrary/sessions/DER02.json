            "functionCall": {
              "id": "adk-1c524428-a300-4da3-8f3b-dd43af7aea45",
              "args": {
                "sql_query": "\nSELECT\n    de.drug_era_id,\n    de.person_id,\n    de.drug_concept_id,\n    SUM(c.total_charge) AS total_economic_cost_era\nFROM\n    `drug_era` AS de\nJOIN\n    `drug_exposure` AS dex\n    ON de.person_id = dex.person_id\n    AND dex.drug_exposure_start_date >= de.drug_era_start_date\n    AND dex.drug_exposure_end_date <= de.drug_era_end_date\nJOIN\n    `cost` AS c\n    ON dex.drug_exposure_id = c.cost_event_id\n    AND c.cost_domain_id = 'Drug'\nGROUP BY\n    de.drug_era_id,\n    de.person_id,\n    de.drug_concept_id\n"
              },
              "name": "validate_omop_sql"
