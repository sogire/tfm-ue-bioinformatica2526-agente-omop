    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-1ef88916-7167-47e1-813c-4fea7adec3f6",
              "args": {
                "sql_query": "\nSELECT\n    COUNT(t.observation_period_start_date) AS total_records,\n    DATE_FROM_UNIX_DATE(CAST(AVG(UNIX_DATE(t.observation_period_start_date)) AS BIGNUMERIC)) AS average_start_date,\n    CAST(STDDEV(UNIX_DATE(t.observation_period_start_date)) AS FLOAT64) AS stddev_start_date_in_days,\n    DATE_FROM_UNIX_DATE(CAST(PERCENTILE_CONT(UNIX_DATE(t.observation_period_start_date), 0.25) OVER() AS BIGNUMERIC)) AS q1_start_date,\n    DATE_FROM_UNIX_DATE(CAST(PERCENTILE_CONT(UNIX_DATE(t.observation_period_start_date), 0.50) OVER() AS BIGNUMERIC)) AS median_start_date,\n    DATE_FROM_UNIX_DATE(CAST(PERCENTILE_CONT(UNIX_DATE(t.observation_period_start_date), 0.75) OVER() AS BIGNUMERIC)) AS q3_start_date\nFROM\n    `observation_period` AS t\n"
              },
