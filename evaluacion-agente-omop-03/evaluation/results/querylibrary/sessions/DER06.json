          {
            "functionCall": {
              "id": "adk-e63b4f41-1984-40e5-a000-0e31df7f8f06",
              "args": {
                "sql_query": "\nWITH TotalAntithrombinPatients AS (\n    SELECT\n        COUNT(DISTINCT de.person_id) AS total_persons_in_class\n    FROM\n        `drug_era` AS de\n    JOIN\n        `concept_ancestor` AS ca\n        ON de.drug_concept_id = ca.descendant_concept_id\n    WHERE\n        ca.ancestor_concept_id = 4324992 -- Concept ID for 'Antithrombotics'\n),\nAntithrombinDrugPatients AS (\n    SELECT\n        de.drug_concept_id,\n        c.concept_name AS drug_name,\n        COUNT(DISTINCT de.person_id) AS patients_with_drug\n    FROM\n        `drug_era` AS de\n    JOIN\n        `concept_ancestor` AS ca\n        ON de.drug_concept_id = ca.descendant_concept_id\n    JOIN\n        `concept` AS c\n        ON de.drug_concept_id = c.concept_id\n    WHERE\n        ca.ancestor_concept_id = 4324992 -- Concept ID for 'Antithrombotics'\n    GROUP BY\n        de.drug_concept_id,\n        c.concept_name\n)\nSELECT\n    adp.drug_name,\n    adp.patients_with_drug,\n    tap.total_persons_in_class,\n    CAST(adp.patients_with_drug AS BIGNUMERIC) * 100 / tap.total_persons_in_class AS percentage_of_patients\nFROM\n    AntithrombinDrugPatients AS adp,\n    TotalAntithrombinPatients AS tap\nWHERE\n    tap.total_persons_in_class > 0 -- Avoid division by zero\nORDER BY\n    percentage_of_patients DESC;\n"
              },
