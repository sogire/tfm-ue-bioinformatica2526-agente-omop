            "functionCall": {
              "id": "adk-5e0ec79f-4795-490b-8f46-ccc8729f82f0",
              "args": {
                "sql_query": "\nSELECT\n    EXTRACT(MONTH FROM op.observation_period_end_date) AS end_month,\n    CASE\n        WHEN d.person_id IS NOT NULL AND d.death_date <= op.observation_period_end_date THEN 'Deceased'\n        ELSE 'Alive at end of period'\n    END AS closure_condition,\n    COUNT(op.observation_period_id) AS num_observation_periods\nFROM\n    `observation_period` AS op\nLEFT JOIN\n    `death` AS d\nON\n    op.person_id = d.person_id\nGROUP BY\n    end_month,\n    closure_condition\nORDER BY\n    end_month,\n    closure_condition\n"
              },
              "name": "validate_omop_sql"
            },
