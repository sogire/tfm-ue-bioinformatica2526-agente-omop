            "functionCall": {
              "id": "adk-61cfc752-26b9-45be-bb2f-99ccd49dd187",
              "args": {
                "sql_query": "\nSELECT\n    co.condition_concept_id,\n    cc.concept_name AS condition_concept_name,\n    co.condition_type_concept_id,\n    ctc.concept_name AS condition_type_concept_name,\n    COUNT(co.condition_occurrence_id) AS number_of_episodes,\n    AVG(CAST(DATE_DIFF(co.condition_end_date, co.condition_start_date, DAY) AS BIGNUMERIC)) AS average_duration_days,\n    MIN(DATE_DIFF(co.condition_end_date, co.condition_start_date, DAY)) AS min_duration_days,\n    MAX(DATE_DIFF(co.condition_end_date, co.condition_start_date, DAY)) AS max_duration_days,\n    APPROX_QUANTILES(CAST(DATE_DIFF(co.condition_end_date, co.condition_start_date, DAY) AS BIGNUMERIC), 4)[OFFSET(1)] AS percentile_25_duration_days,\n    APPROX_QUANTILES(CAST(DATE_DIFF(co.condition_end_date, co.condition_start_date, DAY) AS BIGNUMERIC), 4)[OFFSET(2)] AS percentile_50_duration_days,\n    APPROX_QUANTILES(CAST(DATE_DIFF(co.condition_end_date, co.condition_start_date, DAY) AS BIGNUMERIC), 4)[OFFSET(3)] AS percentile_75_duration_days\nFROM\n    `condition_occurrence` AS co\nJOIN\n    `concept` AS cc\n    ON co.condition_concept_id = cc.concept_id\nJOIN\n    `concept` AS ctc\n    ON co.condition_type_concept_id = ctc.concept_id\nWHERE\n    co.condition_end_date IS NOT NULL AND co.condition_start_date IS NOT NULL\nGROUP BY\n    co.condition_concept_id,\n    cc.concept_name,\n    co.condition_type_concept_id,\n    ctc.concept_name\nORDER BY\n    number_of_episodes DESC;\n"
              },
              "name": "validate_omop_sql"
