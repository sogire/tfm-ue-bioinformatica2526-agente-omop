              "args": {
                "sql_query": "\nSELECT\n    DATE_FROM_UNIX_DATE(CAST(AVG(UNIX_DATE(condition_start_date)) AS BIGNUMERIC)) AS mean_start_date,\n    STDDEV(UNIX_DATE(condition_start_date)) AS stddev_days_from_epoch, -- Standard deviation is in days relative to epoch\n    DATE_FROM_UNIX_DATE(CAST(PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY UNIX_DATE(condition_start_date)) AS BIGNUMERIC)) AS p25_start_date,\n    DATE_FROM_UNIX_DATE(CAST(PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY UNIX_DATE(condition_start_date)) AS BIGNUMERIC)) AS p50_median_start_date,\n    DATE_FROM_UNIX_DATE(CAST(PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY UNIX_DATE(condition_start_date)) AS BIGNUMERIC)) AS p75_start_date\nFROM\n    `condition_occurrence`\n"
              },
              "name": "validate_omop_sql"
            },
