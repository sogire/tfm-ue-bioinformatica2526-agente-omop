                "sql_query": "\nSELECT\n    de.person_id,\n    de.drug_concept_id,\n    c.concept_name AS drug_name,\n    COUNT(de.drug_exposure_id) AS dispensation_count\nFROM\n    drug_exposure de\nJOIN\n    concept c\nON\n    de.drug_concept_id = c.concept_id\nWHERE\n    de.drug_concept_id IN (906805, 1517070, 19010522)\nGROUP BY\n    de.person_id,\n    de.drug_concept_id,\n    c.concept_name\nORDER BY\n    de.person_id,\n    de.drug_concept_id\n"
