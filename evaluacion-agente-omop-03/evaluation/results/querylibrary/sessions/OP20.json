        "parts": [
          {
            "functionCall": {
              "id": "adk-57695bd6-ac8d-4e29-ae18-e15857c72d99",
              "args": {
                "sql_query": "\nSELECT\n    c.concept_name AS gender,\n    MIN(DATE_DIFF(op.observation_period_end_date, op.observation_period_start_date, DAY) + 1) AS min_observation_days,\n    MAX(DATE_DIFF(op.observation_period_end_date, op.observation_period_start_date, DAY) + 1) AS max_observation_days,\n    AVG(DATE_DIFF(op.observation_period_end_date, op.observation_period_start_date, DAY) + 1) AS avg_observation_days,\n    STDDEV(DATE_DIFF(op.observation_period_end_date, op.observation_period_start_date, DAY) + 1) AS stddev_observation_days,\n    PERCENTILE_CONT(0.25) OVER (PARTITION BY c.concept_name ORDER BY DATE_DIFF(op.observation_period_end_date, op.observation_period_start_date, DAY) + 1) AS percentile_25_observation_days,\n    PERCENTILE_CONT(0.50) OVER (PARTITION BY c.concept_name ORDER BY DATE_DIFF(op.observation_period_end_date, op.observation_period_start_date, DAY) + 1) AS median_observation_days,\n    PERCENTILE_CONT(0.75) OVER (PARTITION BY c.concept_name ORDER BY DATE_DIFF(op.observation_period_end_date, op.observation_period_start_date, DAY) + 1) AS percentile_75_observation_days,\n    COUNT(DISTINCT op.person_id) AS number_of_people\nFROM\n    `observation_period` AS op\nJOIN\n    `person` AS p\n    ON op.person_id = p.person_id\nJOIN\n    `concept` AS c\n    ON p.gender_concept_id = c.concept_id\nWHERE\n    p.year_of_birth IS NOT NULL\nGROUP BY\n    c.concept_name\nORDER BY\n    c.concept_name\n"
              },
              "name": "validate_omop_sql"
            },
