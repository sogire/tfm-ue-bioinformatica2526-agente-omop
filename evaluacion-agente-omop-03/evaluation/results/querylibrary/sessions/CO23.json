    },
    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-1dbff193-cbb3-4449-9126-84efcfc76596",
              "args": {
                "sql_query": "SELECT\n    EXTRACT(YEAR FROM co.condition_start_date) AS diagnosis_year,\n    EXTRACT(MONTH FROM co.condition_start_date) AS diagnosis_month,\n    c.concept_name,\n    COUNT(co.condition_occurrence_id) AS number_of_diagnoses\nFROM\n    `condition_occurrence` AS co\nINNER JOIN\n    `concept` AS c\nON\n    co.condition_concept_id = c.concept_id\nWHERE\n    co.condition_concept_id IN (192279, 4128221)\nGROUP BY\n    diagnosis_year,\n    diagnosis_month,\n    c.concept_name\nORDER BY\n    diagnosis_year,\n    diagnosis_month,\n    c.concept_name;"
              },
              "name": "validate_omop_sql"
