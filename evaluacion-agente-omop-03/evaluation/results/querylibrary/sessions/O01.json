            "functionCall": {
              "id": "adk-8af3c273-1aa7-49e1-beae-da08a66a3681",
              "args": {
                "sql_query": "\nSELECT\n    c.concept_id,\n    c.concept_name,\n    c.domain_id,\n    c.vocabulary_id,\n    c.concept_class_id,\n    c.standard_concept,\n    c.concept_code,\n    c.valid_start_date,\n    c.valid_end_date,\n    c.invalid_reason\nFROM\n    `concept` AS c\nWHERE\n    c.concept_id IN (1091161, 3039481, 3051238)\n\nUNION ALL\n\nSELECT\n    cs.concept_id,\n    cs.concept_synonym_name AS concept_name,\n    'N/A' AS domain_id, -- Synonyms don't have a direct domain, using N/A for consistency\n    c.vocabulary_id, -- Getting vocabulary from the main concept table\n    'N/A' AS concept_class_id, -- Synonyms don't have a direct concept_class_id\n    'N/A' AS standard_concept, -- Synonyms are not standard concepts themselves\n    'N/A' AS concept_code, -- Synonyms don't have a direct concept_code\n    c.valid_start_date, -- Getting dates from the main concept table\n    c.valid_end_date,\n    c.invalid_reason\nFROM\n    `concept_synonym` AS cs\nJOIN\n    `concept` AS c\nON\n    cs.concept_id = c.concept_id\nWHERE\n    cs.concept_id IN (1091161, 3039481, 3051238)\n"
