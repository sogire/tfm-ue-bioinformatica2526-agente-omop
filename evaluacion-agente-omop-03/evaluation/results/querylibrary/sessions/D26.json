    {
      "content": {
        "parts": [
          {
            "text": "Confirmo los conceptos 939355. Por favor genera la consulta SQL SELECT para BigQuery consultando las tablas del vocabulario y modelo OMOP (concept, concept_relationship) para obtener los conceptos o registros relacionados."
          }
        ],
        "role": "user"
      },
      "invocationId": "e-dab62b1f-87c1-45d9-9f97-9324dcd7b2e2",
