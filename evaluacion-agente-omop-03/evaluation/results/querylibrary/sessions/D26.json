            "functionCall": {
              "id": "adk-cc9ac13a-611f-4c04-88a3-685816f1f4e3",
              "args": {
                "sql_query": "\nSELECT\n    -- Original Drug Information (the reference clinical drug)\n    c_orig.concept_id AS reference_drug_concept_id,\n    c_orig.concept_name AS reference_drug_name,\n    c_orig.concept_class_id AS reference_drug_class,\n    c_orig.vocabulary_id AS reference_drug_vocabulary,\n    c_orig.valid_start_date AS reference_drug_valid_start,\n    c_orig.valid_end_date AS reference_drug_valid_end,\n\n    -- Relationship Information\n    r.relationship_name AS relationship_to_tradename,\n\n    -- Trade Name / Branded Product Information\n    c_trade.concept_id AS tradename_concept_id,\n    c_trade.concept_name AS tradename_name,\n    c_trade.concept_class_id AS tradename_concept_class,\n    c_trade.vocabulary_id AS tradename_vocabulary,\n    c_trade.valid_start_date AS tradename_valid_start,\n    c_trade.valid_end_date AS tradename_valid_end\nFROM\n    `concept` AS c_orig\nJOIN\n    `concept_relationship` AS cr\n    ON c_orig.concept_id = cr.concept_id_1 -- From reference drug to branded drug\nJOIN\n    `relationship` AS r\n    ON cr.relationship_id = r.relationship_id\nJOIN\n    `concept` AS c_trade\n    ON cr.concept_id_2 = c_trade.concept_id -- To the trade name/branded product\nWHERE\n    c_orig.concept_id = 939355\n    AND c_orig.standard_concept = 'S' -- Ensure it's a standard concept\n    AND c_orig.invalid_reason IS NULL\n    AND CURRENT_DATE() BETWEEN c_orig.valid_start_date AND c_orig.valid_end_date -- Reference drug is currently valid\n    AND c_orig.vocabulary_id = 'RxNorm' -- Focus on RxNorm for drug concepts\n    AND c_orig.concept_class_id IN ('Ingredient', 'Clinical Drug', 'Clinical Drug Form', 'Clinical Drug Comp') -- Common generic drug classes\n\n    -- Filter for relevant relationships that indicate a brand or trade name\n    AND r.relationship_id IN (\n        'Has brand name', -- General relationship for brand name\n        'RxNorm has brand name' -- Specific RxNorm relationship\n    )\n\n    -- Filter for relevant concept classes for the target (trade name / branded product)\n    AND c_trade.concept_class_id IN (\n        'Branded Drug',\n        'Branded Pack',\n        'Brand Name',\n        'Quant Branded Drug',\n        'Branded Drug Form'\n    )\n    AND c_trade.standard_concept = 'S' -- Ensure the target is a standard concept\n    AND c_trade.invalid_reason IS NULL\n    AND CURRENT_DATE() BETWEEN c_trade.valid_start_date AND c_trade.valid_end_date -- Target concept is currently valid\n    AND c_trade.vocabulary_id = 'RxNorm' -- Ensure branded product is also from RxNorm\n;"
              },
              "name": "validate_omop_sql"
            },
