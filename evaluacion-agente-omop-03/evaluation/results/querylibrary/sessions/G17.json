    },
    {
      "modelVersion": "gemini-2.5-flash",
      "content": {
        "parts": [
          {
            "functionCall": {
              "id": "adk-161d2194-af41-4a37-82a8-7cd0bdc3a816",
              "args": {
                "sql_query": "\nSELECT\n    COUNT(DISTINCT de.drug_source_concept_id) AS total_source_drug_concepts,\n    COUNT(DISTINCT\n        CASE\n            WHEN EXISTS (\n                SELECT 1\n                FROM `concept_relationship` cr\n                JOIN `concept` c_target ON cr.concept_id_2 = c_target.concept_id\n                WHERE cr.concept_id_1 = de.drug_source_concept_id\n                  AND cr.relationship_id = 'Maps to'\n                  AND c_target.standard_concept = 'S'\n                  AND c_target.vocabulary_id = 'RxNorm'\n            ) THEN de.drug_source_concept_id\n            ELSE NULL\n        END\n    ) AS mapped_to_rxnorm_concepts,\n    CAST(COUNT(DISTINCT\n        CASE\n            WHEN EXISTS (\n                SELECT 1\n                FROM `concept_relationship` cr\n                JOIN `concept` c_target ON cr.concept_id_2 = c_target.concept_id\n                WHERE cr.concept_id_1 = de.drug_source_concept_id\n                  AND cr.relationship_id = 'Maps to'\n                  AND c_target.standard_concept = 'S'\n                  AND c_target.vocabulary_id = 'RxNorm'\n            ) THEN de.drug_source_concept_id\n            ELSE NULL\n        END\n    ) AS FLOAT64) * 100.0 / COUNT(DISTINCT de.drug_source_concept_id) AS percentage_mapped_to_rxnorm\nFROM\n    `drug_exposure` AS de\nWHERE\n    de.drug_source_concept_id IS NOT NULL;\n"
              },
              "name": "validate_omop_sql"
            },
