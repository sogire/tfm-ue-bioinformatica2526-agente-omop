      "content": {
        "parts": [
          {
            "text": "Calcular la cobertura y estadísticas de mapeo de los vocabularios fuente de medicamentos al vocabulario estándar de fármacos (RxNorm). Genera directamente la consulta SQL para BigQuery."
          }
        ],
        "role": "user"
      },
      "invocationId": "e-cb6e6e40-e0fe-4316-b187-6c407f402b81",
      "author": "user",
      "actions": {
        "stateDelta": {},
