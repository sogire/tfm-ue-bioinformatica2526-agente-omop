            "functionCall": {
              "id": "adk-a52d564d-dbe7-41a5-a17b-c783d3d65237",
              "args": {
                "sql_query": "\nSELECT\n    src.vocabulary_id AS source_vocabulary_id,\n    COUNT(DISTINCT src.concept_id) AS total_source_drug_concepts,\n    COUNT(DISTINCT\n        CASE\n            WHEN EXISTS (\n                SELECT 1\n                FROM `concept_relationship` cr\n                JOIN `concept` target_c ON cr.concept_id_2 = target_c.concept_id\n                WHERE cr.concept_id_1 = src.concept_id\n                  AND cr.relationship_id = 'Maps to'\n                  AND target_c.standard_concept = 'S'\n                  AND target_c.vocabulary_id = 'RxNorm'\n            ) THEN src.concept_id\n            ELSE NULL\n        END\n    ) AS mapped_to_rxnorm_concepts,\n    CAST(COUNT(DISTINCT\n        CASE\n            WHEN EXISTS (\n                SELECT 1\n                FROM `concept_relationship` cr\n                JOIN `concept` target_c ON cr.concept_id_2 = target_c.concept_id\n                WHERE cr.concept_id_1 = src.concept_id\n                  AND cr.relationship_id = 'Maps to'\n                  AND target_c.standard_concept = 'S'\n                  AND target_c.vocabulary_id = 'RxNorm'\n            ) THEN src.concept_id\n            ELSE NULL\n        END\n    ) AS FLOAT64) * 100.0 / COUNT(DISTINCT src.concept_id) AS percentage_mapped_to_rxnorm\nFROM\n    `concept` AS src\nWHERE\n    src.domain_id = 'Drug'\n    AND src.standard_concept IS NULL\n    AND src.vocabulary_id != 'RxNorm'\nGROUP BY\n    src.vocabulary_id\nORDER BY\n    source_vocabulary_id;\n"
              },
              "name": "validate_omop_sql"
            },
